# Default variables for docker-compose.yml. Portainer (Repository) reads this file
# from the repo; variables set in the Portainer UI take precedence over it.
# These defaults are public – set your own before opening the ports to the internet.
# They apply on the first start only (empty volumes).
ADMIN_PASSWORD=admin
VIZRS_TOKEN=vizrs-operator-change-me
VIZRS_OUTPUT_TOKEN=vizrs-output-change-me
